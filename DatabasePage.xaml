<!-- ================================================================
     Features/Database/Views/DatabasePage.xaml
     Translates the Figma "DatabaseView" component to WinUI 3 XAML.
     Layout: header toolbar ? DataGrid with Title/Date/Status/User/Tags
     Business Rules:
       - Dynamic tables: columns defined at runtime (SchemaJson)
       - Audit trail: every row mutation writes a ChangeLog
       - Export to PDF button
       - Search + tag filter
     ================================================================ -->
<Page
    x:Class="WorkSpaceApp.Features.Database.Views.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>    <!-- Header bar -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar: search + filter -->
            <RowDefinition Height="*"/>     <!-- Table content -->
        </Grid.RowDefinitions>

        <!-- ???????????????????????????????????????????????????
             HEADER BAR
             ??????????????????????????????????????????????????? -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Database View"
                           FontSize="15"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <!-- Export to PDF -->
                    <Button Command="{x:Bind ViewModel.ExportPdfCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="8"
                            Padding="12,6"
                            FontSize="13">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A1;" FontSize="13"/>
                            <TextBlock Text="Export to PDF"/>
                        </StackPanel>
                    </Button>

                    <!-- New entry -->
                    <Button Command="{x:Bind ViewModel.AddRowCommand}"
                            CornerRadius="8"
                            Padding="12,6"
                            FontSize="13">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13"/>
                            <TextBlock Text="New Entry"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ???????????????????????????????????????????????????
             TOOLBAR: search + tag filter
             ??????????????????????????????????????????????????? -->
        <Border Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="12">

                <!-- Search box -->
                <AutoSuggestBox Width="320"
                                PlaceholderText="Search entries..."
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                QueryIcon="Find"
                                CornerRadius="8"
                                FontSize="13"/>

                <!-- Tag filter -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71C;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableTags, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTagFilter, Mode=TwoWay}"
                              PlaceholderText="All Tags"
                              FontSize="13"
                              CornerRadius="8"
                              MinWidth="140"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ???????????????????????????????????????????????????
             TABLE CONTENT
             Using ListView with a custom header for lightweight rendering.
             For production, swap with CommunityToolkit DataGrid.
             ??????????????????????????????????????????????????? -->
        <Grid Grid.Row="2" Padding="24">
            <Border CornerRadius="8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Column headers -->
                        <RowDefinition Height="*"/>     <!-- Rows -->
                    </Grid.RowDefinitions>

                    <!-- Column header row -->
                    <Grid Background="{ThemeResource LayerFillColorAltBrush}"
                          Padding="16,10"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>  <!-- Title -->
                            <ColumnDefinition Width="*"/>   <!-- Date -->
                            <ColumnDefinition Width="*"/>   <!-- Status -->
                            <ColumnDefinition Width="*"/>   <!-- Assigned User -->
                            <ColumnDefinition Width="*"/>   <!-- Tags -->
                            <ColumnDefinition Width="40"/>  <!-- Attachment -->
                            <ColumnDefinition Width="40"/>  <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TITLE"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="50"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="DATE"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="50"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="STATUS"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="50"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="ASSIGNED USER"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="50"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="TAGS"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="50"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <!-- Data rows -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FilteredRows, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="Row_Clicked">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>

                                        <!-- Date -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE787;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource ShortDateConverter}}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Status badge -->
                                        <Border Grid.Column="2"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="{Binding Status, Converter={StaticResource StatusToGlyphConverter}}"
                                                          FontSize="11"/>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           FontWeight="Medium"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Assigned user avatar + name -->
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Border Width="24" Height="24"
                                                    CornerRadius="12"
                                                    Background="{ThemeResource SystemAccentColorLight3}">
                                                <TextBlock Text="{Binding AssignedUserInitials}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemAccentColor}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding AssignedUser}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Tags -->
                                        <ItemsControl Grid.Column="4"
                                                      ItemsSource="{Binding TagNames}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4"
                                                            BorderThickness="1"
                                                            BorderBrush="{ThemeResource SystemAccentColorLight1}"
                                                            Background="{ThemeResource SystemAccentColorLight3}"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource SystemAccentColor}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Attachment icon -->
                                        <FontIcon Grid.Column="5"
                                                  Glyph="&#xE723;"
                                                  FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Row actions button -->
                                        <Button Grid.Column="6"
                                                Style="{StaticResource DateTimePickerFlyoutButtonStyle}"
                                                Width="28" Height="28"
                                                Padding="0"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE712;" FontSize="13"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Edit" Icon="Edit"/>
                                                    <MenuFlyoutItem Text="Delete"
                                                                    Icon="Delete"
                                                                    Foreground="Red"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
