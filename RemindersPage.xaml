<!-- ================================================================
     Features/Reminders/Views/RemindersPage.xaml
     Translates Figma "Reminders" component to WinUI 3 XAML.
     - Header: active/completed counts + All/Local/Synced filter pills
     - Active reminders list with colored left-border by priority
     - Completed reminders list (muted / strikethrough)
     ================================================================ -->
<Page
    x:Class="WorkSpaceApp.Features.Reminders.Views.RemindersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>    <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stats + Filter -->
            <RowDefinition Height="*"/>     <!-- List -->
        </Grid.RowDefinitions>

        <!-- ?? Header ??????????????????????????????????????? -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="24,0">
            <Grid>
                <TextBlock Text="Reminders"
                           FontSize="15"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.AddReminderCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="8"
                        Padding="12,6"
                        FontSize="13"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="New Reminder"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ?? Stats Bar + Filter Pills ???????????????????? -->
        <Border Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Stats badges -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border CornerRadius="8"
                            Background="{ThemeResource SystemAccentColorLight3}"
                            BorderBrush="{ThemeResource SystemAccentColorLight1}"
                            BorderThickness="1"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEA8F;" FontSize="14"
                                      Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay, Converter={StaticResource CountLabelConverter}, ConverterParameter='Active'}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource SystemAccentColor}"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#2ed573"/>
                            <TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay, Converter={StaticResource CountLabelConverter}, ConverterParameter='Completed'}"
                                       FontSize="12"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Filter buttons: All | Local | Synced -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6">
                    <Button Content="All"
                            Tag="all"
                            Command="{x:Bind ViewModel.SetFilterCommand}"
                            CommandParameter="all"
                            IsEnabled="{x:Bind ViewModel.IsFilterAll, Mode=OneWay, Converter={StaticResource BoolInverterConverter}}"
                            FontSize="12"
                            CornerRadius="8"
                            Padding="10,6"/>
                    <Button Tag="local"
                            Command="{x:Bind ViewModel.SetFilterCommand}"
                            CommandParameter="local"
                            FontSize="12"
                            CornerRadius="8"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE77B;" FontSize="12"/>
                            <TextBlock Text="Local"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="synced"
                            Command="{x:Bind ViewModel.SetFilterCommand}"
                            CommandParameter="synced"
                            FontSize="12"
                            CornerRadius="8"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE716;" FontSize="12"/>
                            <TextBlock Text="Synced"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ?? Reminder Cards ??????????????????????????????? -->
        <ScrollViewer x:Name="RemindersScroll" DataContext="{x:Bind ViewModel}" Grid.Row="2" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="860" Spacing="24">

                <!-- Active reminders -->
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="ACTIVE REMINDERS"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               CharacterSpacing="50"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveReminders, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    Priority border colors:
                                    High   = Red    (#ff4757) left border
                                    Medium = Blue   (#0067c0) left border
                                    Low    = Muted  left border
                                -->
                                <Border Margin="0,0,0,10"
                                        CornerRadius="8"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Complete toggle -->
                                        <!-- Data Flow: TwoWay binding updates ReminderItem.IsCompleted, triggers OnCompletionChanged callback, then ViewModel.RefreshLists() -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Top"/>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE823;" FontSize="11"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding FormattedTime}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4"
                                                            Visibility="{Binding IsSynced, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <FontIcon Glyph="&#xE716;" FontSize="11"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="From " />
                                                        <Run Text="{Binding Source}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Delete -->
                                        <Button Grid.Column="2"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.DeleteReminderCommand, ElementName=RemindersScroll}"
                                                Style="{StaticResource DateTimePickerFlyoutButtonStyle}"
                                                Width="30" Height="30"
                                                Padding="0"
                                                CornerRadius="6"
                                                VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12"
                                                      Foreground="{ThemeResource SystemErrorTextColor}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Completed reminders (muted) -->
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="COMPLETED"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               CharacterSpacing="50"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CompletedReminders, Mode=OneWay}"
                                  Opacity="0.6">
                        <!-- Same DataTemplate as above – in production extract to ResourceDictionary -->
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
