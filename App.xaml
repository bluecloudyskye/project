<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="WorkSpaceApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkSpaceApp">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
			</ResourceDictionary.MergedDictionaries>

			<local:BoolToVisibilityConverter     x:Key="BoolToVisibilityConverter"/>
			<local:BoolInverterConverter         x:Key="BoolInverterConverter"/>
			<local:CountLabelConverter           x:Key="CountLabelConverter"/>
			<local:PriorityToColorConverter      x:Key="PriorityToColorConverter"/>
			<local:HexColorToBrushConverter      x:Key="HexColorToBrushConverter"/>
			<local:HexColorToVisibilityConverter x:Key="HexColorToVisibilityConverter"/>
		</ResourceDictionary>
	</Application.Resources>
</Application>